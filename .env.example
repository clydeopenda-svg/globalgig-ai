# ── AI (Claude API) ────────────────────────────────────────────────
# Create a key at https://console.anthropic.com/settings/keys
# Without it, the AI Gig Studio offers a clearly labelled demo mode.
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high

# ── PayPal (Sandbox only) ──────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → your app
# The client id is public (sent to the browser for the PayPal buttons);
# the secret is only ever used on the server.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Database ───────────────────────────────────────────────────────
# Leave empty to use a local SQLite file (globalgig.db).
# For serverless hosting, use a Turso database:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
